# ── Database
DATABASE_URL="postgresql://mms_user:YOUR_PASSWORD@localhost:5432/mms_db?schema=public"

# ── Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── File Upload
UPLOAD_DIR="/var/data/mms/uploads"
MAX_FILE_SIZE_MB=5

# ── App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"
